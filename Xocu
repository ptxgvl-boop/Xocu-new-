    local function TeleportCharacterIntoPCLD(hrp, pcld)
        if not hrp or not hrp.Parent or not pcld or not pcld.Parent then return end

        hrp.CFrame = pcld.CFrame + Vector3.new(0, 3, 0)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end

    local function FindPCLD(hrp)
        if pcldConn then pcldConn:Disconnect() end
        MyPCLD = nil
        PCLDWasReplaced = false

        pcldConn = RunService.Heartbeat:Connect(function()
            if not hrp or not hrp.Parent then
                if pcldConn then pcldConn:Disconnect() pcldConn = nil end
                return
            end

            -- Keep the same detector when the player teleports elsewhere.
            -- Only reacquire it if that exact detector is removed.
            if MyPCLD and MyPCLD.Parent then
                -- This counter changes only when the PCLD moves 15+ studs.
                -- A player teleport does not change the detector position.
                local currentPosition = MyPCLD.Position
                if LastPCLDPosition
                    and (currentPosition - LastPCLDPosition).Magnitude >= PCLD_MOVE_CHECK then
                    PCLDMovementId += 1
                    TeleportCharacterIntoPCLD(hrp, MyPCLD)
                end
                LastPCLDPosition = currentPosition
                return
            end

            -- Some games destroy and recreate the detector instead of moving
            -- the same BasePart. Treat that as a PCLD relocation.
            if MyPCLD then
                PCLDWasReplaced = true
            end
            MyPCLD = nil
            LastPCLDPosition = nil

            local nearestPCLD
            local nearestDistance = math.huge

            -- PCLDs may be inside folders/models, so scan all descendants.
            for _, v in ipairs(workspace:GetDescendants()) do
                if v.Name == "PlayerCharacterLocationDetector" and v:IsA("BasePart") then
                    local closestPlayer
                    local closestPlayerDistance = math.huge

