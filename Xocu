    ["Purple stars"] = "rbxassetid://90513035459514",
    ["Dark Monster"] = "rbxassetid://15392628947",
}
local BHK_ActiveModels = {}

local function BHK_ClearModel(model)
    local entry = BHK_ActiveModels[model]
    if entry then
        if entry.Connection then
            entry.Connection:Disconnect()
            entry.Connection = nil
        end
        if entry.Instance then
            entry.Instance:Destroy()
            entry.Instance = nil
        end
        BHK_ActiveModels[model] = nil
    end
end

local function BHK_FadeAndRemove(model, entry)
    if entry.Fading then return end
    entry.Fading = true
    local tweenService = game:GetService("TweenService")
    local fadeInfo = TweenInfo.new(0.85, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local visual = entry.Instance
    if visual then
        for _, object in ipairs(visual:GetDescendants()) do
            if object:IsA("BasePart") then
                object.CanCollide = false
                object.CanTouch = false
                pcall(function()
                    tweenService:Create(object, fadeInfo, {Transparency = 1}):Play()
                end)
            elseif object:IsA("Decal") or object:IsA("Texture") then
                pcall(function()
                    tweenService:Create(object, fadeInfo, {Transparency = 1}):Play()
                end)
            elseif object:IsA("ParticleEmitter") or object:IsA("Trail") or object:IsA("Beam") then
                object.Enabled = false
            end
        end
    end
    task.delay(0.9, function()
        if BHK_ActiveModels[model] == entry then
            BHK_ClearModel(model)
        end
    end)
end

local function BHK_ApplyModel(model)
    if not model then return end
    local hole = model:FindFirstChild("Hole")
    if not hole then return end
    BHK_ClearModel(model)

    local assetId = BHK_ModelOptions[BHK_Settings.ModelMode] or BHK_ModelOptions["Dark Monster"]
    local ok, visual = pcall(function()
        return game:GetObjects(assetId)[1]
    end)
    if not ok or not visual then return end

    visual.Name = "BHK_SelectedModel"
    visual.Parent = model
    local target = hole.Position
    if visual:IsA("Model") then
        for _, part in ipairs(visual:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Anchored = true
                part.CanCollide = false
                part.CanTouch = false
                part.CastShadow = false
                part.Size = part.Size * 0.01
            end
        end
        visual:PivotTo(CFrame.new(target))
    elseif visual:IsA("BasePart") then
        visual.Anchored = true
        visual.CanCollide = false
        visual.CanTouch = false
        visual.CastShadow = false
        visual.Size = visual.Size * 0.01
        visual.CFrame = CFrame.new(target)
    end

    hole.Transparency = 1
    hole.Material = Enum.Material.Plastic
    local beam = hole:FindFirstChild("Attachment") and hole.Attachment:FindFirstChild("Beam")
    if beam then beam.Enabled = false end
    local gui = hole:FindFirstChild("BillboardGui")
    if gui then gui.Enabled = false end

    local entry = {
        Instance = visual,
        Connection = nil,
        Started = os.clock(),
        Fading = false,
    }
    BHK_ActiveModels[model] = entry
    local angle = 0
    entry.Connection = game:GetService("RunService").Heartbeat:Connect(function(dt)
        if not model.Parent or not visual.Parent then
            BHK_ClearModel(model)
            return
        end
        angle += dt * 0.8
        local cf = CFrame.new(target) * CFrame.Angles(0, angle, 0)
        if visual:IsA("Model") then
            visual:PivotTo(cf)
        elseif visual:IsA("BasePart") then
            visual.CFrame = cf
        end
        if not entry.Fading and os.clock() - entry.Started >= 5 then
            BHK_FadeAndRemove(model, entry)
        end
    end)
end

local function BHK_ApplyToModel(model)
    BHK_ApplyModel(model)
end

local function BHK_ApplyCurrent()
    BHK_ApplyToModel(workspace:FindFirstChild("BlackHoleKick"))
end

local function BHK_SetupWatcher()
    if BHK_Settings.WatcherConn then BHK_Settings.WatcherConn:Disconnect() end
    BHK_Settings.WatcherConn = workspace.ChildAdded:Connect(function(child)
        if child.Name == "BlackHoleKick" then
            task.wait(0.1)
            BHK_ApplyToModel(child)
        end
    end)
end
