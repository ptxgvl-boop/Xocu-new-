        desyncEnabled = false

        if currentThread then
            pcall(task.cancel, currentThread)
            currentThread = nil
        end

        threadAlive = false

        -- Stop watchdog
        if heartbeatConnection then
            heartbeatConnection:Disconnect()
            heartbeatConnection = nil
        end

        -- Reset PhysicsRepRootPart safely
        local char = Player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            pcall(sethiddenproperty, hrp, "PhysicsRepRootPart", hrp)
        end
    end

    -- WATCHDOG: Restarts the thread automatically if it dies
    local function startWatchdog()
        if heartbeatConnection then
            heartbeatConnection:Disconnect()
        end

        local checkAccumulator = 0

        heartbeatConnection = RunService.Heartbeat:Connect(function(dt)
            if not desyncEnabled then return end

            checkAccumulator = checkAccumulator + dt
            if checkAccumulator < WATCHDOG_INTERVAL then return end
            checkAccumulator = 0

            local timeSinceHeartbeat = tick() - lastHeartbeat
            local threadDead = isThreadDead()

            if threadDead or timeSinceHeartbeat > WATCHDOG_INTERVAL + 2 then
                warn("[Desync] Watchdog: Dead thread detected, restarting...")
                startDesync()
            end
        end)
    end

