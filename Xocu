        if massless then
            pcall(function()
                if ap then ap.Responsiveness = GrabMasslessPower; ap.MaxForce = math.huge; ap.MaxVelocity = math.huge end
                if ao then ao.Responsiveness = GrabMasslessPower; ao.MaxTorque = math.huge end
            end)
        else
