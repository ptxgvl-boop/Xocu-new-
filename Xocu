                        local issyncinrn = false

                        while desyncEnabled and Player.Character == char do
                            -- Update heartbeat for the watchdog
                            threadAlive = true
                            lastHeartbeat = tick()

                            if issyncinrn then
                                task.wait()
                                continue
                            end

                            if dsfs <= 0 then
                                issyncinrn = true
                                pcall(sethiddenproperty, hrp, "PhysicsRepRootPart", nil)
