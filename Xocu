                    startDesync()
                end
            end
        end
    end)

    -- Create UI Toggle
    MiscGroup:CreateToggle({
        Name = "DESYNC",
        Flag = "DESYNC",
        Default = false,
        Callback = function(Value)
            -- Sync with global state management
            if SetToggleState then SetToggleState("DESYNC", Value) end
            desyncEnabled = Value
            
