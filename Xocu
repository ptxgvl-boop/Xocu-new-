                        local candidateRoot = candidateCharacter
                            and candidateCharacter:FindFirstChild("HumanoidRootPart")
                        if candidateRoot then
                            local distanceToPlayer = GetMagnitude(v, candidateRoot)
                            if distanceToPlayer < closestPlayerDistance then
                                closestPlayer = candidatePlayer
                                closestPlayerDistance = distanceToPlayer
                            end
                        end
                    end

                    if closestPlayer == plr then
                        local distanceToLocalPlayer = GetMagnitude(v, hrp)
                        if distanceToLocalPlayer < nearestDistance then
                            nearestPCLD = v
                            nearestDistance = distanceToLocalPlayer
                        end
                    end
                end
            end

            if nearestPCLD then
                MyPCLD = nearestPCLD
                LastPCLDPosition = nearestPCLD.Position
                if PCLDWasReplaced then
                    PCLDMovementId += 1
                    TeleportCharacterIntoPCLD(hrp, nearestPCLD)
                    PCLDWasReplaced = false
                end
            end
        end)
    end

