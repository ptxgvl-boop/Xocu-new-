-- Single notification entry point. Obsidian expects a config table; older parts
-- of this script used the Linoria-style (text, duration) form, so normalize both
-- forms here and protect each notification from a UI error.
local function playNotificationSound()
    local sound = Instance.new("Sound")
    sound.SoundId = _G.XOCU_NotificationSoundId or "rbxassetid://129485210015224"
    sound.Volume = 1
    sound.Parent = game:GetService("SoundService")
    sound:Play()
    sound.Ended:Connect(function()
        sound:Destroy()
    end)
end

local function notify(title, content, duration)
    local payload
    if type(title) == "table" then
        payload = {}
        for key, value in pairs(title) do
            payload[key] = value
        end
        payload.Title = payload.Title or "Notification"
        -- Obsidian renders Description; accept Content for older call sites.
        payload.Description = payload.Description or payload.Content or ""
        payload.Content = nil
        payload.Duration = payload.Duration or content or duration or 5
    else
        payload = {
            Title = title or "Notification",
            Description = content or "",
            Duration = duration or 5,
        }
    end

    local ok, err = pcall(function()
        Library:Notify(payload)
    end)
    if ok then
        playNotificationSound()
    end
    if not ok then
        warn("[xocu notification error] " .. tostring(err))
    end
end
