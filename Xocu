        Frame = frame, Stroke = stroke, Label = label, Corner = corner,
        SetTheme = function(theme)
            theme = theme or {}
            frame.BackgroundColor3 = theme.MainColor or theme.BackgroundColor or Color3.fromRGB(8, 8, 12)
            stroke.Color = theme.OutlineColor or Color3.fromRGB(0, 0, 0)
            icon.ImageColor3 = theme.AccentColor or Color3.fromRGB(255, 255, 255)
            label.TextColor3 = theme.FontColor or Color3.fromRGB(255, 255, 255)
            hudTextHex = colorToHex(theme.FontColor or Color3.fromRGB(255, 255, 255))
        end,
        SetCornerRadius = function(value)
            corner.CornerRadius = UDim.new(0, math.clamp(tonumber(value) or 3, 0, 20))
        end,
    }

    local dragging = false
    local dragStart
    local startPosition
    local dragInput
    local inputService = game:GetService("UserInputService")

    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPosition = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    inputService.InputChanged:Connect(function(input)
        if dragging and input == dragInput then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPosition.X.Scale, startPosition.X.Offset + delta.X, startPosition.Y.Scale, startPosition.Y.Offset + delta.Y)
        end
    end)

