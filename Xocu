;(function()
    local antiBurgerEnabled = false
    local antiBurgerConnection = nil
    local antiBurgerTasks = {}

    local function disconnectAntiBurger()
        if antiBurgerConnection then
            pcall(function()
                antiBurgerConnection:Disconnect()
            end)
            antiBurgerConnection = nil
        end

        for index, thread in pairs(antiBurgerTasks) do
            if thread then
                pcall(function()
                    task.cancel(thread)
                end)
            end
            antiBurgerTasks[index] = nil
        end
    end

    local function getAntiBurgerTarget()
        if selectedKickPlayer
            and typeof(selectedKickPlayer) == "Instance"
            and selectedKickPlayer:IsA("Player")
            and selectedKickPlayer.Parent == PS then
            return selectedKickPlayer
        end

        if type(selectedPlrName) == "string" and selectedPlrName ~= "" then
            return PS:FindFirstChild(selectedPlrName)
        end

        return nil
    end

    local function antiBurgerNotify(title, content)
        if type(notify) == "function" then
            notify(title, content, 3)
        end
    end

    local function waitForRemote(parent, name, timeout)
        if not parent then return nil end

        local existing = parent:FindFirstChild(name)
        if existing then return existing end

        local started = tick()
        repeat
            local remote = parent:FindFirstChild(name)
            if remote then return remote end
            task.wait()
        until not parent.Parent or tick() - started >= (timeout or 2)

        return parent:FindFirstChild(name)
    end

    local function processExistingHoldPart(holdPart, localCharacter)
        if not holdPart or not holdPart.Parent then return end

        local thread = task.spawn(function()
            local holdFunction
            local dropFunction

            repeat
                if not antiBurgerEnabled or not holdPart or not holdPart.Parent then
                    return
                end

                holdFunction = holdPart:FindFirstChild("HoldItemRemoteFunction")
                dropFunction = holdPart:FindFirstChild("DropItemRemoteFunction")

                if not holdFunction then
                    task.wait(0.05)
                end
            until holdFunction or not antiBurgerEnabled or not holdPart.Parent

            if not antiBurgerEnabled or not holdFunction or not holdPart.Parent then
                return
            end

            repeat
                if not antiBurgerEnabled or not holdPart or not holdPart.Parent then
                    break
                end

                holdFunction = holdPart:FindFirstChild("HoldItemRemoteFunction")
                dropFunction = holdPart:FindFirstChild("DropItemRemoteFunction")
                if not holdFunction then break end

                pcall(function()
                    holdFunction:InvokeServer(holdPart.Parent, localCharacter)
                end)

                task.wait(0.05)

                local rigidConstraint = holdPart:FindFirstChild("RigidConstraint")
                local leftArm = localCharacter and localCharacter:FindFirstChild("Left Arm")
                local gripAttachment = leftArm and leftArm:FindFirstChild("LeftGripAttachment")
                local attached = rigidConstraint
                    and rigidConstraint.Attachment1
                    and gripAttachment
                    and rigidConstraint.Attachment1 == gripAttachment

                if attached then
                    break
                end
            until not antiBurgerEnabled or not holdPart.Parent

            if antiBurgerEnabled and dropFunction and holdPart and holdPart.Parent then
                task.spawn(function()
                    pcall(function()
                        dropFunction:InvokeServer(holdPart.Parent)
                    end)
                end)
            end

            if holdPart and holdPart.Parent and holdPart.Name == "HoldPart" then
                holdPart.Name = "NotHoldPart"
            end
        end)

        table.insert(antiBurgerTasks, thread)
    end

    local function processAddedHoldPart(holdPart, localCharacter, localRoot)
        if not holdPart then return end

        local thread = task.spawn(function()
            -- DescendantAdded can fire before the two RemoteFunctions exist.
            local holdFunction = waitForRemote(holdPart, "HoldItemRemoteFunction", 3)
            if not antiBurgerEnabled or not holdFunction or not holdPart.Parent then
                return
            end

            local ok = pcall(function()
                holdFunction:InvokeServer(holdPart.Parent, localCharacter)
            end)
            if not ok then return end

            repeat
                if not antiBurgerEnabled or not holdPart or not holdPart.Parent then
                    break
                end

                if holdPart.AssemblyRootPart ~= localRoot then
                    holdFunction = waitForRemote(holdPart, "HoldItemRemoteFunction", 1)
                    if not holdFunction then break end

                    pcall(function()
                        holdFunction:InvokeServer(holdPart.Parent, localCharacter)
                    end)
                end

                if holdPart.AssemblyRootPart == localRoot then
                    ok = pcall(function()
                        holdFunction:InvokeServer(holdPart.Parent, localCharacter)
                    end)
                end

                task.wait()
            until not ok or not holdPart or not holdPart.Parent or not antiBurgerEnabled
        end)

        table.insert(antiBurgerTasks, thread)
    end

    TargetGroup:CreateToggle({
        Name = "anti-anti input lag",
        Flag = "AntiBurgerTarget",
        Default = false,
        Callback = function(Value)
            antiBurgerEnabled = Value == true
            SetToggleState("AntiBurgerTarget", antiBurgerEnabled)
            disconnectAntiBurger()

            if not antiBurgerEnabled then
                return
            end

            local targetPlayer = getAntiBurgerTarget()
            if not targetPlayer then
                antiBurgerEnabled = false
                SetToggleState("AntiBurgerTarget", false)
                antiBurgerNotify("Anti-Burger", "Select a target first!")
                return
            end

            local targetInventory = workspace:FindFirstChild(targetPlayer.Name .. "SpawnedInToys")
            if not targetInventory then
                antiBurgerEnabled = false
                SetToggleState("AntiBurgerTarget", false)
                antiBurgerNotify("Anti-Burger", "Target inventory was not found.")
                return
            end

            local localCharacter = Player.Character
            local localRoot = localCharacter and localCharacter:FindFirstChild("HumanoidRootPart")
            if not localCharacter or not localRoot then
                antiBurgerEnabled = false
                SetToggleState("AntiBurgerTarget", false)
                antiBurgerNotify("Anti-Burger", "Your character is not ready.")
                return
            end

            -- Process HoldParts already present in the target inventory.
            for _, descendant in ipairs(targetInventory:GetDescendants()) do
                if descendant.Name == "HoldPart" then
                    processExistingHoldPart(descendant, localCharacter)
                end
            end

            -- Process HoldParts added later. The handler waits for delayed
            -- HoldItemRemoteFunction creation before invoking it.
            antiBurgerConnection = targetInventory.DescendantAdded:Connect(function(descendant)
                if antiBurgerEnabled and descendant and descendant.Name == "HoldPart" then
                    processAddedHoldPart(descendant, localCharacter, localRoot)
                end
            end)
        end,
    })
end)()
;(function()
    local players = game:GetService("Players")
    local replicatedStorage = game:GetService("ReplicatedStorage")
    local localPlayer = players.LocalPlayer

    local function characterParts()
        local character = localPlayer.Character
        if not character then return nil end
        local root = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("realHrp")
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        return character, root, humanoid
    end

    local function foodRemote()
        local holdEvents = replicatedStorage:FindFirstChild("HoldEvents")
        local playerEvents = replicatedStorage:FindFirstChild("PlayerEvents")
        local foodEvents = replicatedStorage:FindFirstChild("FoodEvents")
        return holdEvents and holdEvents:FindFirstChild("Use")
            or playerEvents and (playerEvents:FindFirstChild("FoodEat")
                or playerEvents:FindFirstChild("EatFood")
                or playerEvents:FindFirstChild("Eat"))
            or foodEvents and (foodEvents:FindFirstChild("FoodEat")
                or foodEvents:FindFirstChild("Eat"))
    end

    local function useRemote(remote, ...)
        if not remote then return false end
        if remote:IsA("RemoteFunction") then
            return pcall(remote.InvokeServer, remote, ...)
        end
        return pcall(remote.FireServer, remote, ...)
    end

    local function makeFoodEaten(food)
        local character, root, humanoid = characterParts()
        local holdPart = food and food:WaitForChild("HoldPart", 0.15)
        local ediblePart = food and food:WaitForChild("EdiblePart", 0.15)
        if not holdPart or not root or not humanoid or humanoid.Health <= 0 then return end
        if not ediblePart then return food end

        local hold = holdPart:WaitForChild("HoldItemRemoteFunction", 0.15)
        local drop = holdPart:WaitForChild("DropItemRemoteFunction", 0.15)
        if not hold or not drop then return end

        local started = tick()
        repeat
            task.wait()
        until holdPart.AssemblyRootPart == root
            or not holdPart.Parent
            or humanoid.Health == 0
            or tick() - started > 0.7

        if holdPart.AssemblyRootPart ~= root then return end
        local eat = foodRemote()
        if not eat then return end
        useRemote(eat, food, character)

        local eatingStarted = tick()
        repeat
            task.wait()
        until not ediblePart.Parent
            or not holdPart.Parent
            or holdPart.AssemblyRootPart ~= root
            or humanoid.Health == 0
            or tick() - eatingStarted > 4

        if not holdPart.Parent or holdPart.AssemblyRootPart ~= root
            or tick() - eatingStarted > 4 then return end

        local releaseStarted = tick()
        repeat
            task.wait()
        until holdPart.AssemblyRootPart ~= root or tick() - releaseStarted > 0.7

        if holdPart.AssemblyRootPart ~= root then return food end
    end

    local function destroyFood(target)
        if typeof(target) ~= "Instance" or not target:IsA("Player")
            or target == localPlayer or target.Parent ~= players then
            return false, "select a valid target"
        end

        local inventory = workspace:FindFirstChild(target.Name .. "SpawnedInToys")
        if not inventory then return false, "target SpawnedInToys was not found" end
        local character, root, humanoid = characterParts()
        if not character or not root or not humanoid or humanoid.Health <= 0 then
            return false, "local character is incomplete"
        end

        local found = 0
        local eaten = 0
        for _, food in ipairs(inventory:GetChildren()) do
            if food:IsA("Model") and food.Name:sub(1, 4):lower() == "food" then
                local holdPart = food:WaitForChild("HoldPart", 0.15)
                local hold = holdPart and holdPart:WaitForChild("HoldItemRemoteFunction", 0.15)
                if holdPart and hold then
                    found += 1
                    useRemote(hold, food, character)
                    if makeFoodEaten(food) then eaten += 1 end
                end
            end
        end

        if found == 0 then return false, "target has no spawned food holdables" end
        if eaten == 0 then return false, "food did not complete the Resonance eat sequence" end
        return true
    end

    local destroyFoodEnabled = false
    local destroyFoodRun = 0

    TargetGroup:CreateToggle({
        Name = "Destroy Food",
        Flag = "ResonanceDestroyFood",
        Default = false,
        Callback = function(value)
            destroyFoodEnabled = value == true
            destroyFoodRun += 1
            local run = destroyFoodRun
            if not destroyFoodEnabled then return end
            task.spawn(function()
                while destroyFoodEnabled and run == destroyFoodRun do
                    destroyFood(selectedKickPlayer)
                    task.wait(0.35)
                end
            end)
        end,
    })
end)()
