    local function applyCornerRadius(value)
        value = math.clamp(tonumber(value) or 3, 0, 20)

        -- Obsidian handles normal, half and specific-corner UICorners
        -- differently. Always prefer its native implementation.
        local usedLibraryApi = false
        if type(Window.SetCornerRadius) == "function" then
            usedLibraryApi = pcall(function()
                Window:SetCornerRadius(value)
            end)
        end

        -- Fallback only for library builds without SetCornerRadius.
        if not usedLibraryApi then
            local roots = {
                Window.MainFrame,
                Window.MainWindow,
                Window.Container,
                Library.MainFrame,
            }
            local seen = {}
            for _, root in ipairs(roots) do
                if root and not seen[root] then
                    seen[root] = true
                    pcall(function()
                        for _, object in ipairs(root:GetDescendants()) do
                            if object:IsA("UICorner") then
                                object.CornerRadius = UDim.new(0, value)
                            end
                        end
                    end)
                end
            end
        end

        if type(Window.Theme) == "table" then
            Window.Theme.CornerRadius = value
        end
        if _G.XOCUPerformanceHUD and type(_G.XOCUPerformanceHUD.SetCornerRadius) == "function" then
            pcall(function() _G.XOCUPerformanceHUD.SetCornerRadius(value) end)
        end
    end
