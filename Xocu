    local frameTimer = tick()
    local displayFPS, displayPing = 60, 0
    local targetFPS, targetPing = 60, 0

    local function easeOutQuad(t)
        return 1 - (1 - t) * (1 - t)
    end
    local function smooth(current, target)
        local diff = target - current
        if math.abs(diff) < 0.5 then return target end
        local step = diff * (0.18 + easeOutQuad(math.min(1, math.abs(diff) / 60)) * 0.35)
        if math.abs(step) < 1 and math.abs(diff) > 2 then step = diff > 0 and 1 or -1 end
        return current + step
    end
    local function fpsColor(v)
        return v <= 30 and "#FC7C7C" or (v >= 50 and "#7CFC98" or "#FCD34D")
    end
    local function pingColor(v)
        return v <= 60 and "#7CFC98" or (v <= 150 and "#FCD34D" or "#FC7C7C")
    end

