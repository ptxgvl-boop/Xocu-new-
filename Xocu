    local function applySchemeColor(name, color)
        if typeof(color) ~= "Color3" then return end

        -- Update the library Scheme used by registered controls.
        Library.Scheme[name] = color

        -- Also update the active window Theme so the window shell, tabs,
        -- search bar, footer and newly-created controls use the same color.
        if type(Window.Theme) == "table" then
            if name == "AccentColor" then
                Window.Theme.ElementAccent = color
                Window.Theme.GradientStart = color
                Window.Theme.GradientEnd = color
            elseif name == "MainColor" then
                Window.Theme.Main = color
            elseif name == "BackgroundColor" then
                Window.Theme.Second = color
            elseif name == "FontColor" then
                Window.Theme.TextColor = color
            end
        end

        if _G.XOCUPerformanceHUD and type(_G.XOCUPerformanceHUD.SetTheme) == "function" then
            pcall(function() _G.XOCUPerformanceHUD.SetTheme(Library.Scheme) end)
        end
        if type(Library.UpdateColorsUsingRegistry) == "function" then
            pcall(function()
                Library:UpdateColorsUsingRegistry()
            end)
        end

        -- Some library versions keep direct shell colors outside Registry.
        local shell = Window.MainFrame or Window.MainWindow
        if shell then
            pcall(function()
                if name == "BackgroundColor" or name == "MainColor" then
                    shell.BackgroundColor3 = color
                end
            end)
        end
    end

