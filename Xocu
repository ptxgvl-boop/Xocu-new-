local function sendChatText(text)
    if type(text) ~= "string" or text == "" then return false end

    local channel = RBXGeneral
    if not channel and TextChatService:FindFirstChild("TextChannels") then
        channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
    end
    if channel and type(channel.SendAsync) == "function" then
        local ok = pcall(channel.SendAsync, channel, text)
        if ok then return true end
    end

    local legacyEvents = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
    local legacyRequest = legacyEvents and legacyEvents:FindFirstChild("SayMessageRequest")
    if legacyRequest and legacyRequest:IsA("RemoteEvent") then
        return pcall(legacyRequest.FireServer, legacyRequest, text, "All")
    end
    return false
end

