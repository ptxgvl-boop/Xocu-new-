    function FGM.UpdateConfig(section, axis, rawValue)
        local cfg = FGM.Configuration
        if cfg[section] and cfg[section][axis] ~= nil then
            cfg[section][axis] = FGM.ApplySnap(section, axis, rawValue)
        end
