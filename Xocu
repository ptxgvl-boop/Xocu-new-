        if not target then return end
        for _, name in ipairs({ 'Head', 'Left Arm', 'Right Arm', 'Left Leg', 'Right Leg' }) do
            local part = target:FindFirstChild(name)
            if part then state.FrozenCFrames[name] = part.CFrame end
