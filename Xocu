-- Integrated Christmas house controls (adapted for the main script UI)
local ChristmasHouseGroup = Tabs.Server:CreateBlock({Name = "Christmas", Side = "Left"})

ChristmasHouseHidden = false
ChristmasHouseHideConns = {}

function isChristmasHouse(obj)
    local nameLower = obj.Name:lower()
    return nameLower:find("christmas")
        or nameLower:find("gingerbread")
        or nameLower:find("playhouse")
end

function hideChristmasHouse(obj)
    if not obj or not obj.Parent then return end
    if not isChristmasHouse(obj) then return end

    for _, desc in ipairs(obj:GetDescendants()) do
        if desc:IsA("BasePart") then
            if desc:GetAttribute("OrigTransparency") == nil then
                desc:SetAttribute("OrigTransparency", desc.Transparency)
            end
            desc.Transparency = 1
            desc.CanCollide = false
            desc.CanTouch = false
            desc.CanQuery = false
        elseif desc:IsA("Decal") or desc:IsA("Texture") then
            if desc:GetAttribute("OrigTransparency") == nil then
                desc:SetAttribute("OrigTransparency", desc.Transparency)
            end
            desc.Transparency = 1
        elseif desc:IsA("ParticleEmitter") or desc:IsA("Trail") or desc:IsA("Beam") or desc:IsA("Smoke") or desc:IsA("Fire") or desc:IsA("Sparkles") then
            if desc:GetAttribute("OrigEnabled") == nil then
                desc:SetAttribute("OrigEnabled", desc.Enabled)
            end
            desc.Enabled = false
        elseif desc:IsA("PointLight") or desc:IsA("SpotLight") or desc:IsA("SurfaceLight") then
            if desc:GetAttribute("OrigEnabled") == nil then
                desc:SetAttribute("OrigEnabled", desc.Enabled)
            end
            desc.Enabled = false
        elseif desc:IsA("BillboardGui") or desc:IsA("SurfaceGui") then
            if desc:GetAttribute("OrigEnabled") == nil then
                desc:SetAttribute("OrigEnabled", desc.Enabled)
            end
            desc.Enabled = false
        end
    end
end

function showChristmasHouse(obj)
    if not obj or not obj.Parent then return end

    for _, desc in ipairs(obj:GetDescendants()) do
        if desc:IsA("BasePart") then
            local orig = desc:GetAttribute("OrigTransparency")
            if orig ~= nil then
                desc.Transparency = orig
                desc:SetAttribute("OrigTransparency", nil)
            end
            desc.CanCollide = true
            desc.CanTouch = true
            desc.CanQuery = true
        elseif desc:IsA("Decal") or desc:IsA("Texture") then
            local orig = desc:GetAttribute("OrigTransparency")
            if orig ~= nil then
                desc.Transparency = orig
                desc:SetAttribute("OrigTransparency", nil)
            end
        elseif desc:IsA("ParticleEmitter") or desc:IsA("Trail") or desc:IsA("Beam") or desc:IsA("Smoke") or desc:IsA("Fire") or desc:IsA("Sparkles") then
            local orig = desc:GetAttribute("OrigEnabled")
            if orig ~= nil then
                desc.Enabled = orig
                desc:SetAttribute("OrigEnabled", nil)
            end
        elseif desc:IsA("PointLight") or desc:IsA("SpotLight") or desc:IsA("SurfaceLight") then
            local orig = desc:GetAttribute("OrigEnabled")
            if orig ~= nil then
                desc.Enabled = orig
                desc:SetAttribute("OrigEnabled", nil)
            end
        elseif desc:IsA("BillboardGui") or desc:IsA("SurfaceGui") then
            local orig = desc:GetAttribute("OrigEnabled")
            if orig ~= nil then
                desc.Enabled = orig
                desc:SetAttribute("OrigEnabled", nil)
            end
        end
    end
end

function hideAllChristmasHouses()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isChristmasHouse(obj) and obj:IsA("Model") then
            hideChristmasHouse(obj)
        end
    end
end

function showAllChristmasHouses()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isChristmasHouse(obj) and obj:IsA("Model") then
            showChristmasHouse(obj)
        end
    end
end

function startChristmasHouseHide()
    hideAllChristmasHouses()

    for _, conn in ipairs(ChristmasHouseHideConns) do
        pcall(function() conn:Disconnect() end)
    end
    ChristmasHouseHideConns = {}

    table.insert(ChristmasHouseHideConns, workspace.DescendantAdded:Connect(function(obj)
        if not ChristmasHouseHidden then return end
        if obj:IsA("Model") and isChristmasHouse(obj) then
            task.wait(0.1)
            hideChristmasHouse(obj)
        end
    end))
end

function stopChristmasHouseHide()
    for _, conn in ipairs(ChristmasHouseHideConns) do
        pcall(function() conn:Disconnect() end)
    end
    ChristmasHouseHideConns = {}
    showAllChristmasHouses()
end

