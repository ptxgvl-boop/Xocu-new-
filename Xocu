        end)
    end)
    apexRunService.Heartbeat:Connect(function()
        if not gui.Parent then return end
        displayFPS = smooth(displayFPS, targetFPS)
        displayPing = smooth(displayPing, targetPing)
        local f = math.floor(displayFPS + 0.5)
        local ping = math.floor(displayPing + 0.5)
        updateHudText(f, ping)
    end)
end)

-- Separate xocu UI adapter. Original functionality and callbacks are kept below.
local function loadUILibrary(url)
    local ok, source = pcall(function() return game:HttpGet(url) end)
    if not ok or type(source) ~= 'string' or #source == 0 then return nil end
    local compiled, chunk = pcall(loadstring, source)
    if not compiled or type(chunk) ~= 'function' then return nil end
    local ran, library = pcall(chunk)
    if not ran then return nil end
    return library
end
local _Obsidian = loadUILibrary('https://raw.githubusercontent.com/deividcomsono/Obsidian/main/Library.lua')
if not _Obsidian then
    warn('[xocu UI] Obsidian library failed to load; check HttpGet/loadstring and the executor environment.')
    return
end
local _rawCreateWindow = _Obsidian.CreateWindow
local Library = _Obsidian
Library.Options = Library.Options or {}
Library.Toggles = Library.Toggles or {}
Library.Items = Library.Items or {}
Library.Flags = Library.Flags or {}

-- Obsidian requires globally unique control ids. The original script reused
-- names such as "Others", "Strength", and "AntiGrab", which made the next
-- control throw and hid everything after it.
local _usedControlFlags = {}
local function _flag(cfg)
    local base = tostring(cfg.Flag or cfg.Name or ('xocu_' .. tostring(math.random(100000,999999))))
    local flag = base
    local suffix = 2
    while _usedControlFlags[flag]
        or Library.Options[flag]
        or Library.Toggles[flag]
        or Library.Flags[flag]
        or Library.Items[flag] do
        flag = base .. "_" .. suffix
        suffix = suffix + 1
    end
    _usedControlFlags[flag] = true
    return flag
end
local function _callback(cfg)
    local callback = cfg and (cfg.Callback or cfg.Func)
    if type(callback) ~= 'function' then return nil end
    -- Obsidian safely handles callbacks internally, but this wrapper also logs
    -- errors with the control name so a broken feature does not look like a dead button.
    local controlName = tostring((cfg and (cfg.Name or cfg.Flag)) or 'unnamed')
    return function(...)
        local args = table.pack(...)
        local ok, err = xpcall(function()
            callback(table.unpack(args, 1, args.n))
        end, debug.traceback)
        if not ok then
            warn('[xocu callback error] '..controlName..' | '..tostring(err))
        end
    end
end
local function _bind(obj, callback)
    if obj and type(callback) == "function" and type(obj.OnChanged) == "function" then
        pcall(function() obj:OnChanged(callback) end)
    end
    return obj
end
local function _compatDropdown(obj)
    -- Older parts of this script use the Linoria names Refresh and Set.
    -- Obsidian calls the same operations SetValues and SetValue.
    if obj and type(obj.Refresh) ~= "function" and type(obj.SetValues) == "function" then
        pcall(function()
            function obj:Refresh(values)
                self:SetValues(values or {})
            end
        end)
    end
    if obj and type(obj.Set) ~= "function" and type(obj.SetValue) == "function" then
        pcall(function()
            function obj:Set(value)
                self:SetValue(value)
            end
        end)
    end
    return obj
end
local function _safeCreate(box, text, fn)
    local ok, obj = pcall(fn)
    if ok then return obj end
    warn('[xocu UI] skipped control: '..tostring(text)..' | '..tostring(obj))
    local fallbackOk, fallback = pcall(function() return box:AddLabel('[Unavailable] '..tostring(text)) end)
    return fallbackOk and fallback or nil
end
local function _wrapBlock(box)
    local out = {}
    function out:CreateToggle(cfg)
        cfg=cfg or {}; local flag=_flag(cfg)
        local callback = _callback(cfg)
        -- Keep the script's legacy ToggleStates table in sync with Obsidian.
        -- Many background loops use GetToggleState(flag) as their stop condition.
        local toggleCallback = function(value, ...)
            if type(SetToggleState) == "function" then
                SetToggleState(flag, value == true)
            end
            if callback then
                callback(value, ...)
            end
        end
        local obj=_safeCreate(box,cfg.Name or flag,function()
            return box:AddCheckbox(flag,{
                Text=cfg.Name or flag,
                RichText=(cfg.RichText == true) or (type(cfg.Name) == "string" and cfg.Name:find("<font", 1, true) ~= nil),
                Default=cfg.Default==true,
                Tooltip=cfg.Tooltip,
                Callback=toggleCallback,
            })
        end)
        if obj then
            Library.Toggles[flag]=obj
            Library.Flags[flag]=obj
            Library.Items[flag]=obj
        end
        return obj
    end
    function out:CreateDropdown(cfg)
        cfg=cfg or {}; local flag=_flag(cfg)
        local values=cfg.Items or cfg.Values or cfg.List or {'Select...'}
        if type(values) ~= "table" or #values == 0 then values = {'Select...'} end
        local callback = _callback(cfg)
        local obj=_safeCreate(box,cfg.Name or flag,function()
            return box:AddDropdown(flag,{
                Text=cfg.Name or flag,
                Values=values,
                Default=cfg.Default ~= nil and cfg.Default or values[1],
                Multi=cfg.Multi==true,
                Searchable=cfg.Searchable==true,
                ValueImages=cfg.ValueImages,
                Callback=callback,
            })
        end)
        if obj then
            obj = _compatDropdown(obj)
            Library.Options[flag]=obj
            Library.Items[flag]=obj
        end
        return obj
    end
    function out:CreateSlider(cfg)
        cfg=cfg or {}; local flag=_flag(cfg)
        local callback = _callback(cfg)
        local obj=_safeCreate(box,cfg.Name or flag,function()
            return box:AddSlider(flag,{
                Text=cfg.Name or flag,
                Default=cfg.Default ~= nil and cfg.Default or cfg.Min or 0,
                Min=cfg.Min or 0,
                Max=cfg.Max or 100,
                Rounding=cfg.Rounding or 0,
                Suffix=cfg.Suffix,
                Callback=callback,
            })
        end)
        if obj then
            Library.Options[flag]=obj
            Library.Items[flag]=obj
        end
        return obj
    end
    function out:CreateButton(cfg)
        cfg=cfg or {}; local text=cfg.Name or cfg.Text or 'Button'
        local callback = _callback(cfg)
        return _safeCreate(box,text,function()
            -- Use the documented Obsidian form; it works across current builds.
            return box:AddButton({Text=text, Func=callback})
        end)
    end
    function out:CreateLabel(cfg)
        cfg = cfg or {}
        local text = cfg.Name or cfg.Text or ''
        local ok, obj = pcall(function() return box:AddLabel(text) end)
        return ok and obj or nil
    end
    function out:CreateImage(cfg)
        cfg = cfg or {}; local flag = _flag(cfg)
        local obj = _safeCreate(box, cfg.Name or flag, function()
            return box:AddImage(flag, {
                Image = cfg.Image or 'rbxassetid://0',
                Height = cfg.Height or 180,
            })
        end)
        if obj then
            Library.Options[flag] = obj
            Library.Items[flag] = obj
        end
        return obj
    end
    function out:CreateKeybind(cfg)
        cfg=cfg or {}; local flag=_flag(cfg)
        return _safeCreate(box,cfg.Name or flag,function()
            local obj=box:AddLabel(cfg.Name or flag):AddKeyPicker(flag,{
                Default=cfg.Default or 'None',
                NoUI=false,
                Callback=_callback(cfg),
            })
            Library.Options[flag]=obj
            Library.Items[flag]=obj
            return obj
        end)
    end
    function out:CreateTabbox(cfg)
        cfg = cfg or {}
        -- بعض إصدارات Obsidian لا توفر AddTabbox؛ إرجاع nil هنا
        -- يسبب انهيارًا لاحقًا عند استدعاء CreateTab على النتيجة.
        if type(box.AddTabbox) ~= "function" then
            local fallbackTabs = {}
            function fallbackTabs:CreateTab(name, icon)
                return _wrapBlock(box)
            end
            return fallbackTabs
        end
        local rawTabbox = box:AddTabbox({Name = cfg.Name or "Options", Side = cfg.Side or "Right"})
        local tabs = {}
        function tabs:CreateTab(name, icon)
            local rawTab = rawTabbox:AddTab(name, icon)
            return _wrapBlock(rawTab)
        end
        return tabs
    end
    function out:CreateInput(cfg)
        cfg=cfg or {}; local flag=_flag(cfg)
        if box.AddInput then
            return _safeCreate(box,cfg.Name or flag,function()
                local callback = _callback(cfg)
                local obj=box:AddInput(flag,{
                    Text=cfg.Name or flag,
                    Default=cfg.Default or '',
                    Placeholder=cfg.Placeholder,
                    Numeric=cfg.Numeric==true,
                    Finished=cfg.Finished==true,
                    Callback=callback,
                })
                Library.Options[flag]=obj
                Library.Items[flag]=obj
                return obj
            end)
        end
        return box:AddLabel((cfg.Name or flag)..': '..tostring(cfg.Default or ''))
    end
    function out:CreateColorPicker(cfg)
        cfg=cfg or {}; local flag=_flag(cfg)
        local callback = _callback(cfg)
        return _safeCreate(box,cfg.Name or flag,function()
            local label = box:AddLabel(cfg.Name or flag)
            local obj = label:AddColorPicker(flag,{
                Default = cfg.Default or Color3.new(1, 1, 1),
                Title = cfg.Name or flag,
                Callback = callback,
            })
            Library.Options[flag]=obj
            Library.Items[flag]=obj
            return obj
        end)
    end
    return out
end
Library.CreateWindow=function(self,cfg)
    cfg = cfg or {}
    -- Only pass options understood by the current Obsidian build. The source
    -- config also contains settings from the old UI library.
    local windowCfg = {
        Title = cfg.Title or 'xocu',
        Icon = cfg.Icon or cfg.CustomIcon,
        Footer = cfg.Footer or '',
        DisableSearch = cfg.DisableSearch == true,
        EnableCompacting = true,
        SidebarCompacted = false,
        EnableSidebarResize = true,
        MinSidebarWidth = 48,
        SidebarCompactWidth = 48,
        MinContainerWidth = 500,
        CornerRadius = cfg.CornerRadius or 9,
        ToggleKeybind = cfg.ToggleKeybind or cfg.ToggleKey or Enum.KeyCode.RightControl,
    }
    local window=_rawCreateWindow(self,windowCfg)
    if window and type(window.SetSidebarWidth) == "function" then
        pcall(function()
            window:SetSidebarWidth(160)
        end)
    end
    function window:CreateTab(name,enabled,icon)
        local tab=self:AddTab(name,icon or 'layout-grid',name)
        local rawLeft=tab.AddLeftGroupbox
        local rawRight=tab.AddRightGroupbox
        local usedGroups = {}
        function tab:CreateBlock(blockCfg)
            blockCfg=blockCfg or {}
            local groupBase = tostring(blockCfg.Name or 'xocu')
            local groupName = groupBase
            local groupSuffix = 2
            while usedGroups[groupName] do
                groupName = groupBase .. " " .. groupSuffix
                groupSuffix = groupSuffix + 1
            end
            usedGroups[groupName] = true
            local make=blockCfg.Side=='Right' and rawRight or rawLeft
            local groupIcon = blockCfg.Icon or blockCfg.IconName
            local ok,box=pcall(make,self,groupName,groupIcon)
            if not ok then
                warn('[xocu UI] group failed: '..groupName..' | '..tostring(box))
                local fallbackOk, fallback = pcall(rawLeft,self,groupName)
                if fallbackOk then return _wrapBlock(fallback) end
                return _wrapBlock(self)
            end
            return _wrapBlock(box)
        end
        return tab
    end
    return window
end


