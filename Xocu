-- Shared helpers for the two ownership-defense toggles.
local WorkspaceService = game:GetService("Workspace")
local function finiteCFrame(value)
    if typeof(value) ~= "CFrame" then return false end
    for _, component in ipairs({value:GetComponents()}) do
        if type(component) ~= "number" or component ~= component
            or component == math.huge or component == -math.huge then
            return false
        end
    end
    return true
end

local function localParts()
    local character = Player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    return character, root, humanoid
end

local function findLocalPCLD(root)
    local character = root and root.Parent
    return character and (character:FindFirstChild("PCLD") or character:FindFirstChild("PhysicsController")) or nil
end

local function antiFireRemote(remote, ...)
    if remote and remote:IsA("RemoteEvent") then
        return pcall(remote.FireServer, remote, ...)
    end
    return false
end

local function hostileOwner(part)
    if not (part and part:IsA("BasePart")) then return false end
    local owner = part:FindFirstChild("PartOwner")
    return owner and owner:IsA("StringValue") and owner.Value ~= "" and owner.Value ~= Player.Name
end

local function invalidPartState(part)
    if not (part and part:IsA("BasePart")) then return false end
    local ok, invalid = pcall(function()
        return not finiteCFrame(part.CFrame)
            or part.AssemblyLinearVelocity.Magnitude > 100000
            or part.AssemblyAngularVelocity.Magnitude > 100000
    end)
    return not ok or invalid
end

